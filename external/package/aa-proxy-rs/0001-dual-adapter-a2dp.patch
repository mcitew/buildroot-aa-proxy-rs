--- a/src/bluetooth.rs
+++ b/src/bluetooth.rs
@@ -4477,7 +4477,71 @@ pub async fn init(
     dongle_mode: bool,
     register_aa_wireless_profile: bool,
 ) -> Result<Bluetooth> {
+
+// Standard Bluetooth A2DP Sink Service UUID
+const A2DP_SINK_SERVICE_UUID: Uuid = Uuid::from_u128(0x0000110b_0000_1000_8000_00805f9b34fb);
+
+/// Ensures the Linux virtual Bluetooth kernel module (hci_vhci) is loaded
+fn ensure_vhci_module() {
+    let _ = std::process::Command::new("modprobe").arg("hci_vhci").status();
+}
+
+/// Spawns a dedicated A2DP Sink listener bound strictly to virtual adapter hci1
+pub fn spawn_virtual_a2dp_adapter(session: Arc<Session>) {
+    tokio::spawn(async move {
+        ensure_vhci_module();
+        tokio::time::sleep(Duration::from_millis(500)).await;
+
+        let adapter = match session.adapter("hci1") {
+            Ok(a) => a,
+            Err(_) => {
+                warn!("{} ⚠️ hci1 adapter not found. Is hci_vhci loaded?", NAME);
+                return;
+            }
+        };
+
+        let _ = adapter.set_powered(true).await;
+        let _ = adapter.set_discoverable(true).await;
+        let _ = adapter.set_pairable(true).await;
+        let _ = adapter.set_alias("AA Proxy Media".to_string()).await;
+
+        info!("{} 🎧 Secondary Virtual Adapter (hci1 / AA Proxy Media) activated!", NAME);
+
+        let profile = Profile {
+            uuid: A2DP_SINK_SERVICE_UUID,
+            name: Some("AA Proxy Media".to_string()),
+            role: Some(Role::Server),
+            require_authentication: Some(false),
+            require_authorization: Some(false),
+            auto_connect: Some(true),
+            version: Some(0x0103),
+            features: Some(0x0001),
+            ..Default::default()
+        };
+
+        match session.register_profile(profile).await {
+            Ok(mut profile_handle) => {
+                info!("{} ✅ A2DP Sink listening on hci1", NAME);
+                while let Some(req) = profile_handle.next().await {
+                    let device_addr = req.device();
+                    info!("{} 🎧 A2DP Connection on hci1 from {}", NAME, device_addr);
+                    if let Ok(mut stream) = req.accept() {
+                        tokio::spawn(async move {
+                            let mut buf = [0u8; 1024];
+                            while let Ok(n) = stream.read(&mut buf).await {
+                                if n == 0 { break; }
+                            }
+                        });
+                    }
+                }
+            }
+            Err(e) => warn!("{} ❌ Failed to register A2DP on hci1: {}", NAME, e),
+        }
+    });
+}
     let session = bluer::Session::new().await?;
+    // Spawn secondary virtual A2DP Sink on hci1
+    spawn_virtual_a2dp_adapter(Arc::new(session.clone()));
     let adapter = session.default_adapter().await?;
 
     // setting BT alias for further use
