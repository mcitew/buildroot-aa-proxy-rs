+/// Ensures the Linux virtual Bluetooth kernel module (hci_vhci) is loaded
+fn ensure_vhci_module() {
+    let _ = std::process::Command::new("modprobe").arg("hci_vhci").status();
+}
+
+pub async fn ensure_vhci_adapter_spawned() {
+    use std::sync::Once;
+    use std::io::Write;
+    use std::fs::OpenOptions;
+
+    static VHCI_INIT: Once = Once::new();
+
+    VHCI_INIT.call_once(|| {
+        // 1. Ensure kernel module is loaded first
+        ensure_vhci_module();
+
+        println!("[aa-proxy] Initializing virtual hci1 adapter via /dev/vhci...");
+
+        // 2. Open /dev/vhci and instantiate hci1
+        match OpenOptions::new().read(true).write(true).open("/dev/vhci") {
+           Ok(mut file) => {
+                // Exactly 2 bytes: Packet Type (0xff) + Opcode/DevType (0x01 or 0x00)
+                let vhci_init_pkt: [u8; 2] = [0xff, 0x01];
+
+                if let Err(e) = file.write_all(&vhci_init_pkt) {
+                        eprintln!("[aa-proxy] Failed to write VHCI init bytes: {:?}", e);
+                        return;
+                }
+                println!("[aa-proxy] Successfully spawned hci1 via VHCI!");
+
+                // 3. Keep FD open in background thread so kernel doesn't destroy hci1
+                // 3. Keep FD open AND continuously drain reads so BlueZ initialization doesn't stall
+                std::thread::spawn(move || {
+                   use std::io::{Read, Write};
+                   let mut vhci_file = file;
+                   let mut buf = [0u8; 1024];
+
+                   loop {
+                       match vhci_file.read(&mut buf) {
+                          Ok(n) if n >= 4 => {
+                            // Packet type 0x01 is HCI Command Packet
+                            if buf[0] == 0x01 {
+                              let opcode_gf = buf[1];
+                              let opcode_ocf = buf[2];
+
+                              // Synthesize HCI_Command_Complete Event (0x04)
+                              // Format: [PacketType=0x04, EventCode=0x0e, Plen=0x04, Ncmd=0x01, OpcodeLow, OpcodeHigh, Status=0x00]
+                              let response: [u8; 7] = [
+                                0x04,       // HCI Event Packet
+                                0x0e,       // Command Complete Event
+                                0x04,       // Parameter length
+                                0x01,       // Allowed commands count
+                                opcode_gf,  // Echo back Opcode Low
+                                opcode_ocf, // Echo back Opcode High
+                                0x00,       // Status: Success
+                              ];
+
+                              let _ = vhci_file.write_all(&response);
+                            } 
+                         } 
+                         Ok(_) => {}
+                         Err(e) => {
+                            eprintln!("[aa-proxy] Error reading from VHCI stream: {:?}", e);
+                            break;
+                         }
+                      } 
+                    }
+                });  
+               } 
+               Err(e) => {
+                  eprintln!("[aa-proxy] Failed to open /dev/vhci: {:?}", e);
+               }
+            }
+          }); // Closes VHCI_INIT.call_once
+
+          // 4. Register profiles strictly with the hci1 adapter session
+          if let Ok(session) = bluer::Session::new().await {
+                // Retry loop to give BlueZ up to 2 seconds to see hci1
+                for _ in 0..10 {
+                    if let Ok(adapter) = session.adapter("hci1") {
+                    let _ = adapter.set_powered(true).await;
+                    info!("[aa-proxy] Successfully bound media sink profiles to hci1");
+                    let _ = register_media_sink_profiles(&session).await;
+                    break;
+                } 
+                tokio::time::sleep(std::time::Duration::from_millis(200)).await;
+          } 
+       } 
+}
