+// Standard Bluetooth Service UUIDs
+pub const A2DP_SINK_UUID: &str = "0000110b-0000-1000-8000-00805f9b34fb";
+pub const AVRCP_TARGET_UUID: &str = "0000110e-0000-1000-8000-00805f9b34fb";
+
+// L2CAP Protocol Service Multiplexers
+pub const PSM_AVRCP: u16 = 23;
+pub const PSM_A2DP: u16 = 25;
+
+/// Register fake A2DP and AVRCP profiles with BlueZ via D-Bus
+pub async fn register_media_sink_profiles(session: &bluer::Session) -> bluer::Result<()> {
+    // 1. A2DP Profile
+    let a2dp_profile = Profile {
+        uuid: A2DP_SINK_UUID.parse().unwrap(),
+        psm: Some(PSM_A2DP),
+        require_authentication: Some(false),
+        require_authorization: Some(false),
+        auto_connect: Some(true),
+        name: Some("Android Auto Media Sink".to_string()),
+        ..Default::default()
+    };
+    
+    if let Err(e) = session.register_profile(a2dp_profile).await {
+        warn!("Failed to register A2DP Sink profile: {:?}", e);
+    } else {
+        info!("Successfully registered synthetic A2DP Sink profile (PSM 25)");
+    }
+
+    // 2. AVRCP Controller Profile (0x110E - Receiver / Display)
+    let avrcp_profile = Profile {
+       uuid: SDP_AVRCP_CONTROLLER_UUID,
+       psm: Some(PSM_AVRCP),
+       require_authentication: Some(false),
+       require_authorization: Some(false),
+       auto_connect: Some(true),
+       //role: Some(bluer::ProfileRole::Client), // Explicitly declare Controller/Client role to BlueZ
+       name: Some("Android Auto AVRCP Controller".to_string()),
+       ..Default::default()
+    };
+
+    if let Err(e) = session.register_profile(avrcp_profile).await {
+        warn!("Failed to register AVRCP Controller profile: {:?}", e);
+    } else {
+        info!("Successfully registered synthetic AVRCP Controller profile (PSM 23)");
+    }
+
+    Ok(())
+}
